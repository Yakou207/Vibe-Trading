<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CSI 300 post-close paper cycle. Fires at minute 30 of every hour; the wrapper picks the due
  session from the Asia/Shanghai clock, so a changed Mac time zone, sleep or a missed fire are
  harmless and extra fires exit as up_to_date.
  launchd itself must not open anything under ~/Desktop (macOS privacy protection makes a job
  loaded at login fail with EX_CONFIG), so there is no WorkingDirectory and launchd's own output
  goes to ~/Library/Logs/VibeTrading. The wrapper still logs under outputs/automation/.
  launchd does not inherit the login shell, so the proxy used by manual runs is set here.
  Install/uninstall: see docs/operations.md "定时自动运行（launchd）".
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vibetrading.csi300-post-close</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/yakou/Desktop/Vibe-Trading/.venv/bin/python</string>
    <string>/Users/yakou/Desktop/Vibe-Trading/scripts/run_scheduled_csi300_post_close.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HTTP_PROXY</key>
    <string>http://127.0.0.1:1082</string>
    <key>HTTPS_PROXY</key>
    <string>http://127.0.0.1:1082</string>
    <key>NO_PROXY</key>
    <string>localhost,127.0.0.1,::1,.local</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/yakou/Library/Logs/VibeTrading/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yakou/Library/Logs/VibeTrading/launchd.err.log</string>
</dict>
</plist>
